// ================= MPU6050 =================
const uint8_t MPU_ADDR = 0x68;

bool sensorReady = false;

const int gyroOffsetX = -540;
const int gyroOffsetY = 150;

const int deadZone = 500;
const float sensitivity = 0.008;
const float smoothFactor = 0.75;
