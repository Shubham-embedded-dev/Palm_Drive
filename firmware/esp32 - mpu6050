// ================= MPU REGISTER FUNCTIONS =================
bool writeRegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission() == 0;
}

bool readRegisters(
  uint8_t startReg,
  uint8_t count,
  uint8_t *buffer
) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(startReg);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  uint8_t received = Wire.requestFrom(
    MPU_ADDR,
    count,
    (uint8_t)true
  );

  if (received != count) {
    return false;
  }

  for (uint8_t i = 0; i < count; i++) {
    buffer[i] = Wire.read();
  }

  return true;
}

int16_t read16(uint8_t reg) {
  uint8_t data[2];

  if (!readRegisters(reg, 2, data)) {
    return 0;
  }

  return (int16_t)(
    ((uint16_t)data[0] << 8) |
    data[1]
  );
}

// ================= COMMON BLYNK EVENT =================
void sendBlynkEvent(
  const char *eventCode,
  const char *message
) {
  Serial.println();
  Serial.print("Blynk event: ");
  Serial.println(eventCode);

  Serial.println(message);

  if (Blynk.connected()) {
    Blynk.logEvent(eventCode, message);
    Serial.println("Event submitted to Blynk.");
  } else {
    Serial.println(
      "Blynk offline: event not submitted."
    );
  }
}

// ================= EVENT 1: FALL DETECTED =================
void sendFallAlert(
  const char *reason,
  float acceleration
) {
  unsigned long now = millis();

  if (
    lastFallAlertTime != 0 &&
    now - lastFallAlertTime < ALERT_COOLDOWN
  ) {
    Serial.println("Fall alert cooldown active.");
    return;
  }

  lastFallAlertTime = now;

  char message[120];

  snprintf(
    message,
    sizeof(message),
    "%s | Acceleration: %.2f g",
    reason,
    (double)acceleration
  );

  sendBlynkEvent("fall_detected", message);
}

